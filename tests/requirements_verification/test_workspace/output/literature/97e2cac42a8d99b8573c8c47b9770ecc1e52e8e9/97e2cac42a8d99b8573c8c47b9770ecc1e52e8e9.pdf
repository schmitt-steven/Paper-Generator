	xplGlobal.document.metadata={"userInfo":{"institute":false,"member":false,"individual":false,"guest":false,"subscribedContent":false,"fileCabinetContent":false,"fileCabinetUser":false,"institutionalFileCabinetUser":false,"showPatentCitations":true,"showGet802Link":false,"showOpenUrlLink":false,"tracked":false,"institutionUserId":0,"desktop":false,"delegatedAdmin":false,"isInstitutionDashboardEnabled":false,"isInstitutionProfileEnabled":false,"isRoamingEnabled":false,"isDelegatedAdmin":false,"isMdl":false,"isCwg":false,"isIel":false,"isAcademic":false,"isReadAndPublish":false},"authors":[{"name":"Abdinasir Hirsi","affiliation":["Advanced Telecommunication Research Center, Faculty of Electrical and Electronic Engineering, Universiti Tun Hussein Onn Malaysia, Parit Raja, Malaysia"],"bio":{"graphic":"/mediastore/IEEE/content/freeimages/6287639/10820123/10857272/hirsi-3535943-small.gif","p":["Abdinasir Hirsi (Graduate Student Member, IEEE) received the B.S. degree in telecommunication engineering from Mohammad Ali Jinnah University, Karachi, Pakistan, in 2019, and the M.S. degree in electrical engineering, specializing in communication engineering from Bahria University, Karachi, in 2021. He is currently pursuing the Ph.D. degree in electrical engineering with the Universiti Tun Hussein Onn Malaysia (UTHM), Johor, Malaysia. He is also a Graduate Research Assistant (GRA) with the Advance Telecommunication Research Center (ATRC), FKEE, UTHM. His research interests include SDN security, DDoS attack detection and mitigation, cybersecurity, and AI techniques, such as machine learning and deep learning techniques for network intrusion detection. He is an Active Reviewer of IEEE Access, having reviewed over 13 articles in related fields."]},"firstName":"Abdinasir","lastName":"Hirsi","orcid":"0000-0001-8543-6134","id":"37089486450"},{"name":"Mohammed A. Alhartomi","affiliation":["Department of Electrical Engineering, University of Tabuk, Tabuk, Saudi Arabia","Innovation and Entrepreneurship Centre (IEC), University of Tabuk, Tabuk, Saudi Arabia"],"bio":{"graphic":"/mediastore/IEEE/content/freeimages/6287639/10820123/10857272/alhar-3535943-small.gif","p":["Mohammed A. Alhartomi (Member, IEEE) received the Ph.D. degree in electronic and electrical engineering from Leeds University, U.K., in 2016. He is currently an Assistant Professor with the Department of Electrical Engineering, University of Tabuk. His research interests include wireless and mobile communications, signal processing, optical wireless systems design, and visible light communications."]},"firstName":"Mohammed A.","lastName":"Alhartomi","orcid":"0000-0002-5955-8864","id":"38467330600"},{"name":"Lukman Audah","affiliation":["Advanced Telecommunication Research Center, Faculty of Electrical and Electronic Engineering, Universiti Tun Hussein Onn Malaysia, Parit Raja, Malaysia","Faculty of Electrical and Electronic Engineering, Universiti Tun Hussein Onn Malaysia, Parit Raja, Malaysia"],"bio":{"graphic":"/mediastore/IEEE/content/freeimages/6287639/10820123/10857272/audah-3535943-small.gif","p":["Lukman Audah (Member, IEEE) received the Bachelor of Engineering degree in telecommunications from the Universiti Teknologi Malaysia, in 2005, and the M.Sc. degree in communication networks and software and the Ph.D. degree in electronic engineering from the University of Surrey, U.K. He is currently a Senior Lecturer with the Communication Engineering Department, Universiti Tun Hussein Onn Malaysia. His research interests include wireless and mobile communications, internet traffic engineering, network system management, data security, and satellite communications."]},"firstName":"Lukman","lastName":"Audah","orcid":"0000-0002-0958-4474","id":"38230605400"},{"name":"Adeb Salh","affiliation":["Faculty of Information and Communication Technology, University Tunku Abdul Rahman (UTAR), Kampar, Malaysia"],"bio":{"graphic":"/mediastore/IEEE/content/freeimages/6287639/10820123/10857272/salh-3535943-small.gif","p":["Adeb Salh (Member, IEEE) received the bachelor’s degree in electrical and electronic engineering from IBB University, Yemen, in 2007, and the master’s and Ph.D. degrees in electrical and electronic engineering from the Universiti Tun Hussein Onn Malaysia, in 2015 and 2020, respectively. From 2007 to 2012, he was a Lecturer Assistant with the Yareem Community College. From 2020 to 2023, he was a Postdoctoral Researcher with UTHM and UTM. Currently, he is an Assistant Professor with the Faculty of Information and Communication Technology, Universiti Tunku Abdul Rahman. His research interests include 5G, 6G wireless communications, massive MIMO, artificial intelligence (AI), and the Internet of Things (IoT)."]},"firstName":"Adeb","lastName":"Salh","orcid":"0000-0003-0905-2635","id":"37086267986"},{"name":"Nan Mad Sahar","affiliation":["Faculty of Electrical and Electronic Engineering, Universiti Tun Hussein Onn Malaysia, Parit Raja, Malaysia"],"bio":{"graphic":"/mediastore/IEEE/content/freeimages/6287639/10820123/10857272/sahar-3535943-small.gif","p":["Nan Mad Sahar received the Ph.D. degree in electrical engineering, specializing in neural network computing and computer engineering from Okayama University. He is a Senior Lecturer with the Department of Electronic Engineering, Faculty of Electrical and Electronic Engineering, Universiti Tun Hussein Onn Malaysia (UTHM). He is actively involved as a Principal Researcher with UTHM, focusing on computational intelligence, deep learning, and image processing. With extensive experience in supervising postgraduate research and contributing to academia, his work extends into consultation, technical training, and industry-relevant projects across various engineering fields."]},"firstName":"Nan Mad","lastName":"Sahar","orcid":"0000-0002-7861-8148","id":"37088635475"},{"name":"Salman Ahmed","affiliation":["VLSI and Embedded Technology (VEST) Focus Group, Faculty of Electrical and Electronic Engineering, Universiti Tun Hussein Onn Malaysia, Parit Raja, Malaysia"],"bio":{"graphic":"/mediastore/IEEE/content/freeimages/6287639/10820123/10857272/ahmed-3535943-small.gif","p":["Salman Ahmed (Graduate Student Member, IEEE) received the bachelor’s degree in electronic engineering from the Mehran University of Engineering and Technology, Jamshoro, Pakistan, in 2015, and the Master of Engineering degree in industrial automation and control from Quaid-e-Awam University of Science and Technology, Nawabshah, Pakistan, in 2021. He is currently pursuing the Ph.D. degree with the Faculty of Electrical and Electronics Engineering, Universiti Tun Hussein Onn Malaysia (UTHM). He is also a Graduate Research Assistant (GRA) with the Faculty of Electrical and Electronics Engineering, UTHM. He was a Lecturer in electronics engineering with Sukkur IBA University, Pakistan, from 2017 to 2022. His research interests include network security, cryptographic, and resource-constrained Internet of Things devices."]},"firstName":"Salman","lastName":"Ahmed","orcid":"0009-0003-7129-7892","id":"37089206793"},{"name":"Godwin Okon Ansa","affiliation":["Department of Computer Science, Faculty of Physical Sciences, Akwa Ibom State University, Akwa Ibom, Nigeria"],"bio":{"graphic":"/mediastore/IEEE/content/freeimages/6287639/10820123/10857272/ansa-3535943-small.gif","p":["Godwin Okon Ansa (Member, IEEE) received the B.Sc. degree in computer science from the University of Uyo, Nigeria, in 2003, and the M.Sc. degree in communications networks and software and the Ph.D. degree in electronic engineering (network security) from the University of Surrey, Guildford, U.K., in 2008 and 2013, respectively. He is a Senior Lecturer and the Postgraduate Program Coordinator with the Department of Computer Science, Akwa Ibom State University, Nigeria. Previously, he was the Ag. Head of the Department of Computer Science, Akwa Ibom State University, from 2013 to 2015 and from 2017 to 2020. His research interests include network security, artificial intelligence, delay tolerant networks, cloud computing security, and the Internet of Things. He is a member of Nigeria Computer Society (NCS), the Computer Professionals [Registration Council] of Nigeria (CPN), and the International Association of Engineers (IAENG). He is a member of the Editorial Advisory Board of Journal of ICT Development, Applications and Research; and Researchers Journal of Science and Technology (REJOST)."]},"firstName":"Godwin Okon","lastName":"Ansa","orcid":"0000-0003-1107-5959","id":"355308197104355"},{"name":"Abdullahi Farah","affiliation":["Engineering Department, Somtel Telecommunication Company, Bosaso, Bari, Somalia"],"bio":{"graphic":"/mediastore/IEEE/content/freeimages/6287639/10820123/10857272/farah-3535943-small.gif","p":["Abdullahi Farah received the Bachelor of Science degree in computer science from Mogadishu University, Somalia, in 2012, and the Master of Science degree in information technology from Open University Malaysia, in 2015. He is a distinguished telecommunications professional with over 12 years of comprehensive experience in the industry. He is currently the Technical Operations Manager with Somtel Telecom, Somalia, where he oversees and supervises technical teams across critical domains, including intelligent networks, network operation centers, radio development centers, transmission, IP, power systems, and various other technical projects. His expertise spans advanced telecommunications technologies, such as 4G and 5G, bolstered by specialized training workshops conducted by industry leaders, such as Huawei and Nokia. Over the years, he has played a pivotal role in transformative projects, including spearheading the fiber optic cabling project in Somalia, where Somtel connected the entire country through an extensive fiber optic networks. Starting his career at Somtel, he has risen through various roles, eventually becoming a Project Planning Manager, a position in which he demonstrated strong leadership, adaptability, and innovation. His consistent delivery of exceptional results and his ability to lead complex projects have solidified his reputation as a key figure in Somalia’s telecommunications industry. He remains committed to driving technological advancements and fostering growth in the sector."]},"firstName":"Abdullahi","lastName":"Farah","id":"109408269308775"}],"issn":[{"format":"Electronic ISSN","value":"2169-3536"}],"articleNumber":"10857272","mediaPath":"/mediastore/IEEE/content/media/6287639/10820123/10857272","dbTime":"3 ms","metrics":{"wosCitationCount":0,"citationCountPaper":27,"citationCountPatent":0,"totalDownloads":5010},"purchaseOptions":{"showOtherFormatPricingTab":false,"showPdfFormatPricingTab":true,"pdfPricingInfoAvailable":false,"otherPricingInfoAvailable":false,"mandatoryBundle":false,"optionalBundle":false,"displayTextWhenPdfPricingNotAvailable":"The purchase and pricing options for this item are unavailable. Select items are only available as part of a subscription package. You may try again later or <a href='https://ieeexplore.ieee.org/xpl/contact' target='_blank'>contact us</a> for more information.","displayTextWhenOtherFormatPricingNotAvailable":"The purchase and pricing options for this item are unavailable. Select items are only available as part of a subscription package. You may try again later or <a href='https://ieeexplore.ieee.org/xpl/contact' target='_blank'>contact us</a> for more information."},"getProgramTermsAccepted":false,"sections":{"abstract":"true","authors":"true","disclaimer":"false","figures":"true","multimedia":"false","references":"true","citedby":"true","keywords":"true","definitions":"false","algorithm":"false","dataset":"false","cadmore":"false","footnotes":"false","relatedContent":"false","metrics":"true"},"graphicalAbstract":{"summary":"Comprehensive taxonomy of DDoS vulnerabilities in SDN. Figure (a) highlights the SDN architecture and its vulnerabilities across application, control, and infrastructure layers, targeting points like HTTP floods, table overflows, and SYN floods. Figure (b) categorizes DDoS attacks into flooding, botnet, application layer, protocol, amplification, and reflection, showcasing multi-layered SDN security challenges.","type":"graphic","fileSize":"46KB","file":"/ielx8/6287639/10820123/10857272/graphical_abstract/access-gagraphic-3535943.jpg","coverImage":"/ielx8/6287639/10820123/10857272/graphical_abstract/access-gagraphic-3535943.jpg"},"abstract":"Software-Defined Networking (SDN) offers significant advantages for modern networks, including flexibility, centralized control, and reduced dependency on vendor-specific hardware. However, these benefits introduce security vulnerabilities, particularly from Distributed Denial-of-Service (DDoS) attacks, which represent some of the most disruptive threats to SDN environments. A review of the literature shows that while various techniques have been proposed to counteract DDoS threats, many studies have focused on single detection methods, with only a few utilizing multiple approaches. This fragmented focus limits a comprehensive approach to addressing DDoS threats across the SDN layers. To bridge this gap, this paper presents the first comprehensive review of DDoS anomaly detection in SDN, examining over 165 primary research articles published between 2020 and 2024. A novel taxonomy of DDoS attacks is introduced, categorizing them by distinct characteristics, and mapping each attack type to relevant detection methods within specific SDN layers. The survey provides a layer-by-layer analysis of DDoS detection techniques, covering the application, control, and infrastructure layers, and offers a structured overview that clarifies the applicability and effectiveness of each method. The paper concludes by synthesizing key findings, identifying unresolved challenges, and outlining future research directions to advance DDoS detection mechanisms in SDN. This roadmap is designed to guide researchers in addressing security vulnerabilities and enhancing SDN resilience against evolving DDoS threats.","publicationDate":"2025","pdfPath":"/iel8/6287639/10820123/10857272.pdf","publicationYear":"2025","formulaStrippedArticleTitle":"Comprehensive Analysis of DDoS Anomaly Detection in Software-Defined Networks","publicationTitle":"IEEE Access","startPage":"23013","endPage":"23071","displayPublicationTitle":"IEEE Access","pdfUrl":"/stamp/stamp.jsp?tp=&arnumber=10857272","keywords":[{"type":"IEEE Keywords","kwd":["Computer crime","Surveys","Denial-of-service attack","Taxonomy","Security","Floods","Anomaly detection","Software defined networking","Reviews","Hardware"]},{"type":"Index Terms","kwd":["Anomaly Detection","Distributed Denial Of Service","Detection Methods","Center For Control","Detection Techniques","Types Of Attacks","Denial Of Service","Security Vulnerabilities","Application Layer","Convolutional Neural Network","Long Short-term Memory","Detection Model","Internet Of Things Devices","Network Management","Attack Detection","Traffic Patterns","Environmental Detection","Intrusion Detection System","Control Plane","Impact Of Attacks","Transmission Control Protocol","Virtual Network Functions","DoS Attacks","User Datagram Protocol","Flow Table","Attack Patterns","Attack Vector","Nature Of Attacks","Minimal Overhead","Traffic Flow"]},{"type":"Author Keywords","kwd":["Amplification attacks","anomaly detection","botnet attacks","DDoS detection","flooding attacks","protocol attacks","reflection attacks","SDN security","software-defined networking (SDN)","taxonomy of DDoS attacks"]}],"doiLink":"https://doi.org/10.1109/ACCESS.2025.3535943","authorNames":"Abdinasir Hirsi;Mohammed A. Alhartomi;Lukman Audah;Adeb Salh;Nan Mad Sahar;Salman Ahmed;Godwin Okon Ansa;Abdullahi Farah","displayPublicationDate":"29 January 2025","dateOfInsertion":"29 January 2025","pubLink":"/xpl/RecentIssue.jsp?punumber=6287639","allowComments":true,"issueLink":"/xpl/tocresult.jsp?isnumber=10820123&punumber=6287639","isGetAddressInfoCaptured":false,"isMarketingOptIn":false,"pubTopics":[{"name":"Aerospace"},{"name":"Bioengineering"},{"name":"Communication, Networking and Broadcast Technologies"},{"name":"Components, Circuits, Devices and Systems"},{"name":"Computing and Processing"},{"name":"Engineered Materials, Dielectrics and Plasmas"},{"name":"Engineering Profession"},{"name":"Fields, Waves and Electromagnetics"},{"name":"General Topics for Engineers"},{"name":"Geoscience"},{"name":"Nuclear Engineering"},{"name":"Photonics and Electrooptics"},{"name":"Power, Energy and Industry Applications"},{"name":"Robotics and Control Systems"},{"name":"Signal Processing and Analysis"},{"name":"Transportation"}],"publisher":"IEEE","displayDocTitle":"Comprehensive Analysis of DDoS Anomaly Detection in Software-Defined Networks","isJournal":true,"isFreeDocument":true,"isTutorial":false,"isProduct":false,"isSpringer":false,"isChapter":false,"isStandard":false,"isBookWithoutChapters":false,"xploreDocumentType":"Journals & Magazine","isDynamicHtml":true,"volume":"13","isBook":false,"isEarlyAccess":false,"isOpenAccess":true,"isEphemera":false,"isConference":false,"isOnlineOnly":false,"isPromo":false,"persistentLink":"https://ieeexplore.ieee.org/servlet/opac?punumber=6287639","isTranslation":false,"isNow":false,"isSMPTE":false,"htmlLink":"/document/10857272/","htmlAbstractLink":"/document/10857272/","hasStandardVersions":false,"isSAE":false,"isLatestStandard":false,"isGiveaway":false,"isOUP":false,"isDegruyter":false,"isCustomDenial":false,"startPage":"23013","fundingAgencies":{"fundingAgency":[{"fundingName":"Ministry of Higher Education (MOHE) through Fundamental Research Grant Scheme","grantNumber":"FRGS/1/2022/TK07/UTHM/02/25"}]},"subjectCategories":["Communications technology","Computational and artificial intelligence","Computers and information processing"],"openAccessFlag":"T","insertDate":"29 January 2025","ephemeraFlag":"false","title":"Comprehensive Analysis of DDoS Anomaly Detection in Software-Defined Networks","html_flag":"false","ml_html_flag":"true","sourcePdf":"access-audah-3535943-x.pdf","displayPublicationDate":"29 January 2025","mlTime":"PT0.286499S","xplore-pub-id":"6287639","pdfPath":"/iel8/6287639/10820123/10857272.pdf","isNumber":"10820123","contentType":"periodicals","publicationDate":"2025","publicationNumber":"6287639","citationCount":"27","xplore-issue":"10820123","articleId":"10857272","publicationTitle":"IEEE Access","sections":{"abstract":"true","authors":"true","disclaimer":"false","figures":"true","multimedia":"false","references":"true","citedby":"true","keywords":"true","definitions":"false","algorithm":"false","dataset":"false","cadmore":"false","footnotes":"false","relatedContent":"false","metrics":"true"},"volume":"13","contentTypeDisplay":"Journals","referenceCount":293,"publicationYear":"2025","subType":"IEEE Journal","_value":"CCBY","lastupdate":"2026-03-07","mediaPath":"/mediastore/IEEE/content/media/6287639/10820123/10857272","endPage":"23071","displayPublicationTitle":"IEEE Access","doi":"10.1109/ACCESS.2025.3535943"};








